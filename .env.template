# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Copy this file to ~/.env and fill in your actual values
# 
# Setup instructions:
#   cp ~/.env.template ~/.env
#   # Edit ~/.env with your actual API keys and tokens
#   # The .env file is git-ignored and will not be committed
# ==============================================================================

# API Keys
export GEMINI_API_KEY=your_gemini_api_key_here
export NOTION_TOKEN=your_notion_token_here
export ONFIDO_API_KEY=your_onfido_api_key_here
export HONEYBADGER_API_KEY=your_honeybadger_api_key_here
export HONEYBADGER_PROJECT_ID=your_project_id_here

# Jira/Confluence
export JIRA_URL=https://your-domain.atlassian.net
export JIRA_USERNAME=your.email@company.com
export JIRA_API_TOKEN=your_jira_api_token_here
export CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
export CONFLUENCE_USERNAME=your.email@company.com
export CONFLUENCE_API_TOKEN=your_confluence_api_token_here

# Add other sensitive environment variables below
# export OTHER_API_KEY=your_key_here

# Note: Google Cloud credentials are managed separately via gcloud CLI
# and stored in ~/.config/gcloud/ (already excluded from git)
